# Settings for the browser (Playwright) journeys. Everything here is hermetic:
# a throwaway SQLite file, pretend answer/embedding/web-page services, no
# background workers and emails written to the log instead of being sent.
# APP_URL comes from playwright.config.ts, which owns the port.
APP_NAME="Assistant Studio"
APP_ENV=e2e
APP_KEY=base64:vGKI1NOsWRVQO+4VgBZTcwLcVOVJEiYh8B8UjcIe0Fg=
APP_DEBUG=true

BCRYPT_ROUNDS=4

LOG_CHANNEL=e2e
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/e2e.sqlite

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
FILESYSTEM_DISK=e2e

STUDIO_ANSWER_DRIVER=fake
STUDIO_EMBEDDING_DRIVER=fake
STUDIO_URL_FETCH_DRIVER=fake
