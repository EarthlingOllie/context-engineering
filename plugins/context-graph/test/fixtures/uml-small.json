{
  "format": "context-graph/solution@2",
  "title": "UML small fixture",
  "note": "Every UML kind and relation kind, all three remove forms, in-sugar, a revive, a member cascade and an abandon cascade.",
  "ops": [
    { "op": "add", "kind": "goal", "label": "Draw the design" },
    { "op": "add", "kind": "decision", "id": "decision:core", "label": "Pure core" },
    { "op": "add", "kind": "constraint", "id": "constraint:no-dom", "label": "Panes have no DOM" },
    { "op": "link", "from": "constraint:no-dom", "to": "decision:core", "kind": "constrains" },
    { "op": "uml.add", "decision": "decision:core", "kind": "component", "name": "Shell", "code": "../hooks/register.tsx", "operations": ["+register(on)"] },
    { "op": "uml.add", "decision": "decision:core", "kind": "component", "name": "Renderer", "code": "core/render.ts", "operations": ["+render(scene) string"], "attributes": ["MAX: number"] },
    { "op": "uml.add", "decision": "decision:core", "kind": "interface", "name": "Options", "code": "core/render.ts#Options", "in": "uml:renderer", "attributes": ["theme: 'dark' | 'light'", "width: number"] },
    { "op": "uml.add", "decision": "decision:core", "kind": "class", "name": "BaseShape", "stereotype": "abstract", "operations": ["+area() number"] },
    { "op": "uml.add", "decision": "decision:core", "kind": "class", "name": "Circle", "attributes": ["-r: number"] },
    { "op": "uml.add", "decision": "decision:core", "kind": "interface", "name": "Drawable", "operations": ["draw(ctx)"] },
    { "op": "uml.add", "decision": "decision:core", "kind": "interface", "name": "Shape", "attributes": ["kind: string"] },
    { "op": "uml.relate", "decision": "decision:core", "kind": "dependency", "from": "uml:shell", "to": "uml:renderer", "label": "draws with" },
    { "op": "uml.relate", "decision": "decision:core", "kind": "association", "from": "uml:renderer", "to": "uml:base-shape", "label": "shapes" },
    { "op": "uml.relate", "decision": "decision:core", "kind": "generalization", "from": "uml:circle", "to": "uml:base-shape" },
    { "op": "uml.relate", "decision": "decision:core", "kind": "realization", "from": "uml:circle", "to": "uml:drawable" },
    { "op": "uml.relate", "decision": "decision:core", "kind": "generalization", "from": "uml:drawable", "to": "uml:shape" },
    { "op": "add", "kind": "decision", "id": "decision:webgl", "label": "WebGL in the pane" },
    { "op": "uml.add", "decision": "decision:webgl", "kind": "class", "name": "GlRenderer", "code": "core/gl.ts", "operations": ["+frame()"] },
    { "op": "uml.add", "decision": "decision:webgl", "kind": "component", "name": "Renderer", "operations": ["+renderGl(scene)"] },
    { "op": "uml.relate", "decision": "decision:webgl", "kind": "composition", "from": "uml:renderer", "to": "uml:gl-renderer" },
    { "op": "uml.relate", "decision": "decision:webgl", "kind": "realization", "from": "uml:gl-renderer", "to": "uml:drawable" },
    { "op": "abandon", "id": "decision:webgl", "reason": "No WebGL in panes" },
    { "op": "add", "kind": "decision", "id": "decision:trim", "label": "Trim the shapes" },
    { "op": "uml.remove", "decision": "decision:trim", "reason": "circles only", "id": "uml:shape" },
    { "op": "uml.remove", "decision": "decision:trim", "reason": "fixed size", "id": "uml:options", "member": "width" },
    { "op": "uml.remove", "decision": "decision:trim", "reason": "renderer does not own shapes", "from": "uml:renderer", "kind": "association", "to": "uml:base-shape" },
    { "op": "uml.add", "decision": "decision:core", "kind": "interface", "name": "Shape", "attributes": ["kind: 'circle'"] },
    { "op": "uml.relate", "decision": "decision:core", "kind": "dependency", "from": "uml:shell", "to": "uml:options", "label": "theme" }
  ]
}
